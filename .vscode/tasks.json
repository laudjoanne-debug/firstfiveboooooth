{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Start FirstFiveBooth web server",
            "type": "process",
            "command": "py",
            "args": [
                "-u",
                "-m",
                "http.server",
                "8080",
                "--bind",
                "127.0.0.1"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "isBackground": true,
            "problemMatcher": {
                "owner": "custom",
                "pattern": {
                    "regexp": "^(.*)$",
                    "message": 1
                },
                "background": {
                    "activeOnStart": true,
                    "endsPattern": "Serving HTTP on"
                }
            }
        }
    ]
}
